{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "proud-firefly-b533",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
